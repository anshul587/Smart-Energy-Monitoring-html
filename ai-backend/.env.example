# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# Path to your Firebase service-account JSON key (Admin SDK).
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. This is a SEPARATE, server-side credential — do not reuse
# the ESP32's FIREBASE_DEVICE_EMAIL/FIREBASE_DEVICE_PASSWORD from config.h.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# Same RTDB instance the ESP32 (config.h FIREBASE_DATABASE_URL) and
# dashboard (script.js firebaseConfig.databaseURL) already use.
FIREBASE_DATABASE_URL=https://smart-energy-monitoring-5a2a4-default-rtdb.asia-southeast1.firebasedatabase.app

# Matches config.h PZEM_COUNT.
PZEM_COUNT=9

# Data source: "live" (default) reads from history/pzem_N/ (firmware-written real PZEM data)
# "synthetic" reads from ai/synthetic_history/pzem_N/ (seed script, for testing/demo only).
# Production MUST use "live". Set only for testing/demo explicitly.
DATA_SOURCE=live

# AI analysis window in days. Matches config.h HISTORY_RETENTION_SECONDS
# (60 days = 5184000 seconds). This is independent of the dashboard's
# 1d/7d/30d visualization filter in script.js.
HISTORY_RETENTION_DAYS=60

# Electricity rate per kWh for bill prediction. Used by bill_prediction.py
# and scheduler.py (run_ai_pipeline). Must be >0 for a bill number.
BILL_RATE_PER_KWH=5.0

# Where per-meter history parquet caches are stored on disk.
AI_CACHE_DIR=./.cache

# Stage 7 (peak detection) annotation threshold in watts. Default 0 = off.
# This is informational only — peaks are detected and persisted regardless,
# and this is NOT the Stage 4 fault threshold (FAULT_HIGH_POWER_W).
PEAK_POWER_THRESHOLD_W=0

# Used starting Stage 16 (Ask BOB / Claude integration). Leave blank until
# then — data_loader.py does not require it.
ANTHROPIC_API_KEY=

# Render deployment: host and port. Render sets these automatically,
# but API_HOST defaults to 0.0.0.0 for container compatibility.
API_HOST=0.0.0.0
API_PORT=8000
